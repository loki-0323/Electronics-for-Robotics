#!/usr/bin/env python3
"""
SkyRon-TL test flight simulator

Run the GUI: python skyron_tl_simulator.py
Custom route: python skyron_tl_simulator.py --start 17.7175 83.3166 --dest 28.6139 77.209
Headless summary: python skyron_tl_simulator.py --headless --dest 13.0827 80.2707
Save a screenshot: python skyron_tl_simulator.py --snapshot shot.png

Requires: Python 3.9+, numpy, matplotlib (pip install numpy matplotlib)
The Vizag coastline/landmark layer is a hand-drawn sketch; elsewhere the map is a plain lat/lon grid.
"""
import argparse
import math

import numpy as np

R = 6371008.8
RAD = math.pi / 180
DEF_S, DEF_D = (17.7175, 83.3166), (17.7473, 83.3452)
WPD = [(17.7175, 83.3166), (17.7225, 83.3205), (17.7295, 83.3240),
(17.7370, 83.3315), (17.7425, 83.3395), (17.7473, 83.3452)]
LANDMARKS = [("RK Beach", 17.7175, 83.3166), ("Kailasagiri", 17.7473, 83.3452),
("Kali Temple", 17.7140, 83.3236), ("Submarine Museum", 17.7115, 83.3250),
("Tenneti Park", 17.7385, 83.3395), ("Vizag Port", 17.696, 83.302)]
COAST = [(17.695, 83.314), (17.708, 83.322), (17.7175, 83.3255), (17.727, 83.331),
(17.737, 83.3385), (17.745, 83.3495), (17.752, 83.356), (17.76, 83.364)]
KAILASAGIRI = (17.7473, 83.3452)
CARD8 = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]

----------------------------------------------------------------- geometry
def hav(a, b):
f1, f2, dl = a[0] * RAD, b[0] * RAD, (b[1] - a[1]) * RAD
h = math.sin((f2 - f1) / 2) ** 2 + math.cos(f1) * math.cos(f2) * math.sin(dl / 2) ** 2
return 2 * R * math.asin(min(1.0, math.sqrt(h)))

def bearing(a, b):
f1, f2, dl = a[0] * RAD, b[0] * RAD, (b[1] - a[1]) * RAD
y = math.sin(dl) * math.cos(f2)
x = math.cos(f1) * math.sin(f2) - math.sin(f1) * math.cos(f2) * math.cos(dl)
return (math.atan2(y, x) / RAD + 360) % 360

def great_circle(a, b, n):
f1, l1, f2, l2 = a[0] * RAD, a[1] * RAD, b[0] * RAD, b[1] * RAD
d = hav(a, b) / R
if math.sin(d) < 1e-9:
return [tuple(a), tuple(b)]
out = []
for i in range(n + 1):
f = i / n
A, B = math.sin((1 - f) * d) / math.sin(d), math.sin(f * d) / math.sin(d)
x = A * math.cos(f1) * math.cos(l1) + B * math.cos(f2) * math.cos(l2)
y = A * math.cos(f1) * math.sin(l1) + B * math.cos(f2) * math.sin(l2)
z = A * math.sin(f1) + B * math.sin(f2)
out.append((math.atan2(z, math.hypot(x, y)) / RAD, math.atan2(y, x) / RAD))
return out

def catmull_rom(W, per=20):
out = []
for i in range(len(W) - 1):
p0, p1, p2, p3 = W[max(i - 1, 0)], W[i], W[i + 1], W[min(i + 2, len(W) - 1)]
for k in range(per):
t = k / per
out.append(tuple(0.5 * ((2 * p1[j]) + (-p0[j] + p2[j]) * t
+ (2 * p0[j] - 5 * p1[j] + 4 * p2[j] - p3[j]) * t * t
+ (-p0[j] + 3 * p1[j] - 3 * p2[j] + p3[j]) * t ** 3) for j in (0, 1)))
out.append(W[-1])
return out

def ground_alt(p):
return 105.0 if hav(p, KAILASAGIRI) < 500 else 5.0

def smooth(x):
x = min(max(x, 0.0), 1.0)
return x * x * (3 - 2 * x)

def fmt_time(s):
s = max(0, round(s))
h, m, sec = s // 3600, s % 3600 // 60, s % 60
return f"{h}:{m:02d}:{sec:02d}" if h else f"{m:02d}:{sec:02d}"

--------------------------------------------------------------- simulation
class Flight:
ACC = 1.5

def __init__(self, start, dest):
    self.set_route(start, dest)

def set_route(self, start, dest):
    """Fresh mission from `start` to `dest` (resets drone state)."""
    self.start, self.dest = tuple(start), tuple(dest)
    self._build(self.start, self.dest)
    g = ground_alt(self.start)
    self.t = self.d = self.v = self.vs = 0.0
    self.alt = self.a0 = g
    self.bat = 100.0
    self.pw = 95.0
    self.hdg = self.at(0)[2]
    self.cap = max(100.0, 1.3 * (95 + self.vmax * 7) * self.L / self.vmax / 3600)
    self.hist = {k: [] for k in ("t", "alt", "spd", "bat", "pw")}
    self.est = self.L / self.vmax + 25
    self.hi = max(1.0, self.est / 400)
    self.trail = []
    self.status, self.log = "STANDBY", []
    self.note("Route %.2f km%s" % (self.L / 1000,
              f" - pack auto-sized to {self.cap:.0f} Wh" if self.cap > 100.5 else ""))

def _build(self, a, b):
    if a == DEF_S and b == DEF_D:
        self.pts = catmull_rom(WPD)
    else:
        self.pts = great_circle(a, b, min(400, max(40, math.ceil(hav(a, b) / 200))))
    self.cum = [0.0]
    for i in range(1, len(self.pts)):
        self.cum.append(self.cum[-1] + hav(self.pts[i - 1], self.pts[i]))
    self.L = self.cum[-1]
    self.vmax = 30.0 if self.L > 50000 else 14.0
    self.ea = ground_alt(b)

def note(self, msg):
    self.log.append(f"[{fmt_time(self.t)}] {msg}")

def at(self, d):
    d = min(max(d, 0.0), self.L)
    i = int(np.searchsorted(self.cum, d))
    i = min(max(i, 1), len(self.cum) - 1)
    a, b = self.pts[i - 1], self.pts[i]
    f = (d - self.cum[i - 1]) / ((self.cum[i] - self.cum[i - 1]) or 1)
    dl = (b[1] - a[1] + 540) % 360 - 180
    return (a[0] + (b[0] - a[0]) * f, (a[1] + dl * f + 540) % 360 - 180, bearing(a, b))

@property
def pos(self):
    p = self.at(self.d)
    return p[0], p[1]

def reroute(self, dest):
    """Change destination mid-flight: new great-circle leg from the current position."""
    here = self.pos
    self.dest = tuple(dest)
    self._build(here, self.dest)
    self.d, self.a0 = 0.0, self.alt
    self.est = self.t + self.L / self.vmax + 25
    self.status = "IN FLIGHT"
    self.note("REROUTE -> %.4f, %.4f (%.2f km)" % (dest[0], dest[1], self.L / 1000))
    if (95 + self.vmax * 7) * self.L / self.vmax / 3600 > self.bat / 100 * self.cap:
        self.note("WARNING: remaining charge may not cover this route")

@property
def done(self):
    return self.status in ("MISSION COMPLETE", "BATTERY DEPLETED")

def step(self, dt):
    if self.done:
        return
    L, rem = self.L, self.L - self.d
    dc, dd = min(0.15 * L, 600), min(0.2 * L, 800)
    tv = min(self.vmax, self.ACC * (self.t + 1), math.sqrt(2 * self.ACC * max(rem, 0) + 1))
    if self.d < 40:
        tv = min(tv, 3 + self.t * 1.2)
    wind = math.sin(self.t / 7) * 0.4 + math.sin(self.t / 2.3) * 0.15
    self.v += (tv - self.v) * min(dt * 1.2, 1)
    self.d = min(L, self.d + max(self.v, 0) * dt)
    ta = (self.a0 + (145 - self.a0) * smooth(self.d / dc)
          - (145 - self.ea) * smooth((self.d - (L - dd)) / dd) + math.sin(self.t / 3) * 0.6)
    na = self.alt + (ta - self.alt) * min(dt * 0.8, 1)
    self.vs, self.alt = (na - self.alt) / dt, na
    tgt = self.at(self.d + 15)[2]
    dh = (tgt - self.hdg + 540) % 360 - 180
    self.hdg = (self.hdg + dh * min(dt * 1.5, 1) + wind * dt * 2) % 360
    self.pw = 95 + self.v * 7 + max(self.vs, 0) * 45
    self.bat = max(0.0, self.bat - self.pw * dt / (self.cap * 36))
    self.t += dt
    if self.t >= len(self.hist["t"]) * self.hi:
        for k, v in zip(("t", "alt", "spd", "bat", "pw"), (self.t, self.alt, self.v, self.bat, self.pw)):
            self.hist[k].append(v)
    ph = "CLIMB" if self.d < dc else "DESCENT" if self.d > L - dd else "CRUISE"
    if self.status in ("IN FLIGHT", "CLIMB", "CRUISE", "DESCENT") and ph != self.status:
        self.note("Phase: " + ph)
    if self.bat <= 0 and self.d < L - 1:
        self.status = "BATTERY DEPLETED"
        self.note("Battery depleted - emergency landing %.2f km short" % ((L - self.d) / 1000))
    elif self.d >= L - 0.5:
        self.status = "MISSION COMPLETE"
        self.note("Arrived at destination. Battery %.1f%%" % self.bat)
    else:
        self.status = ph

def eta(self):
    if self.done:
        return 0.0
    avg = max(self.d / self.t, self.v * 0.8) if self.t > 5 and self.v > 1 else self.vmax * 0.85
    return (self.L - self.d) / avg if self.t > 0 else self.L / (self.vmax * 0.9) + 8
def headless(args):
f = Flight(args.start, args.dest)
f.status = "IN FLIGHT"
while not f.done and f.t < 1e7:
f.step(0.2)
print("\n".join(f.log))
print(f"Distance {f.L / 1000:.2f} km | flight time {fmt_time(f.t)} | battery left {f.bat:.1f}% "
f"| pack {f.cap:.0f} Wh | status {f.status}")

