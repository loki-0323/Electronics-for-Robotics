def to_km(lat, lon):
    v = state["view"]
    return ((lon - v["lon"] + 540) % 360 - 180) * v["c"] * 111.32, (lat - v["lat"]) * 111.32

def fit():
    f = state["fl"]
    P = f.pts + [f.start] + f.trail[::5]
    b0 = f.pts[0][1]
    la = [p[0] for p in P]; lo = [(p[1] - b0 + 540) % 360 - 180 for p in P]
    cl = (min(la) + max(la)) / 2
    state["view"] = {"lat": cl, "lon": b0 + (min(lo) + max(lo)) / 2, "c": max(math.cos(cl * RAD), 0.05)}

def draw_static():
    f = state["fl"]
    ax_map.clear(); ax_map.set_facecolor("#030b14"); ax_map.set_aspect("equal"); ax_map.grid(color="#0b2a40")
    ax_map.set_title("ROUTE MAP  |  LIVE OVERLAY", color=DIM, fontsize=9)
    ax_map.set_xlabel("km east", fontsize=8); ax_map.set_ylabel("km north", fontsize=8)
    for obj in drone_glow + [drone, trail]:
        ax_map.add_line(obj) if obj.axes is None else None
    fit()
    xy = np.array([to_km(*p) for p in f.pts])
    pad = max(0.4, 0.18 * max(np.ptp(xy[:, 0]), np.ptp(xy[:, 1])))
    xs, ys = list(xy[:, 0]), list(xy[:, 1])
    if state["fl"].trail:
        t = np.array([to_km(*p) for p in f.trail]); xs += list(t[:, 0]); ys += list(t[:, 1])
    cx, cy = (min(xs) + max(xs)) / 2, (min(ys) + max(ys)) / 2
    half = max(max(xs) - min(xs), max(ys) - min(ys)) / 2 + pad
    ax_map.set_xlim(cx - half * 1.25, cx + half * 1.25); ax_map.set_ylim(cy - half, cy + half)
    # Vizag layer (only meaningful near Vizag at close zoom)
    cp = np.array([to_km(*p) for p in COAST])
    lim = (*ax_map.get_xlim(), *ax_map.get_ylim())
    near = half < 30 and cp[:, 0].max() > lim[0] and cp[:, 0].min() < lim[1] and cp[:, 1].max() > lim[2] and cp[:, 1].min() < lim[3]
    state["mode"] = "VIZAG MAP LAYER" if near else "GRID VIEW - NO LOCAL MAP DATA"
    if near:
        d = cp[-1] - cp[0]; d /= np.hypot(*d); n = np.array([-d[1], d[0]]) * -1  # right-hand normal (sea side)
        ext = [cp[0] - (cp[1] - cp[0]) * 80, *cp, cp[-1] + (cp[-1] - cp[-2]) * 80]
        ax_map.add_patch(Polygon(np.array(ext + [ext[-1] + n * 200, ext[0] + n * 200]), closed=True, fc="#05304f", ec="none", zorder=1))
        ex = np.array(ext)
        for lw, al in ((9, .08), (5, .18), (2, 1)):
            ax_map.plot(ex[:, 0], ex[:, 1], color=C, lw=lw, alpha=al, zorder=2)
        for name, la, lo in LANDMARKS:
            x, y = to_km(la, lo)
            ax_map.plot(x, y, "o", color=B, ms=4, zorder=4)
            ax_map.annotate(name, (x, y), xytext=(6, 4), textcoords="offset points", color="#7fc8e8", fontsize=7)
    for lw, al in ((10, .08), (6, .16), (2.5, .9)):         # glowing route
        ax_map.plot(xy[:, 0], xy[:, 1], color=B, lw=lw, alpha=al, ls="-" if lw > 3 else "--", zorder=5)
    for p, col, lab in ((f.start, GRN, "START"), (f.dest, AMB, "DEST")):
        x, y = to_km(*p)
        ax_map.plot(x, y, "o", mfc="none", mec=col, ms=14, mew=2, zorder=7)
        ax_map.annotate(lab, (x, y), xytext=(10, -14), textcoords="offset points", color=col, fontsize=8, fontweight="bold")
    ax_map.set_xlabel("km east", fontsize=8)

def refresh_graphs():
    f = state["fl"]; h = f.hist
    tm = max(f.est, f.t * 1.05)
    ln_alt.set_data(h["t"], h["alt"]); ln_spd.set_data(h["t"], h["spd"])
    ln_bat.set_data(h["t"], h["bat"]); ln_pw.set_data(h["t"], h["pw"])
    for ax in (ax_g1, ax_g2):
        ax.set_xlim(0, tm)
    ax_g1.set_ylim(0, 180); ax_g1b.set_ylim(0, 40 if f.vmax > 20 else 20); ax_g2b.set_ylim(0, 300)

def update(_):
    f = state["fl"]
    if state["run"] and not f.done:
        m = state["mult"]
        k = (min(20000, max(1, f.est / 40)) if m == "auto" else float(m)) * 0.05
        n = max(1, math.ceil(k / 0.2))
        for _i in range(n):
            f.step(k / n)
        lat, lon = f.pos
        if not f.trail or hav(f.trail[-1], (lat, lon)) > 0.003 * max(f.L, 300):
            f.trail.append((lat, lon))
    lat, lon = f.pos
    x, y = to_km(lat, lon)
    drone.set_data([x], [y]); drone.set_marker((3, 0, -f.hdg))
    for g in drone_glow:
        g.set_data([x], [y])
    if f.trail:
        t = np.array([to_km(*p) for p in f.trail] + [(x, y)]); trail.set_data(t[:, 0], t[:, 1])
    else:
        trail.set_data([], [])
    needle.set_data([math.radians(f.hdg)] * 2, [0, 0.8])
    hdg_t.set_text(f"{round(f.hdg) % 360:03d}  {CARD8[round(f.hdg / 45) % 8]}")
    status_t.set_text(f.status); status_t.set_color(GRN if f.status in ("CLIMB", "CRUISE", "DESCENT", "IN FLIGHT") else AMB if "DEPL" in f.status else C)
    tele_t.set_text(
        f"ALTITUDE      {f.alt:7.0f} m\nSPEED         {f.v:7.1f} m/s\nVERT SPEED    {f.vs:+7.1f} m/s\n"
        f"DIST LEFT     {(f.L - f.d) / 1000:7.2f} km\nBATTERY       {f.bat:7.1f} %\nVOLTAGE       {21 + 4.2 * f.bat / 100:7.1f} V\n"
        f"LATITUDE      {abs(lat):7.4f} {'S' if lat < 0 else 'N'}\nLONGITUDE     {abs(lon):7.4f} {'W' if lon < 0 else 'E'}")
    eta_t.set_text(f"ETA   {fmt_time(f.eta())}\nT+    {fmt_time(f.t)}\nPROG  {f.d / f.L * 100:5.1f} %\n{state.get('mode', '')}")
    log_t.set_text("\n".join(f.log[-5:][::-1]))
    refresh_graphs()
    return ()

# ---- controls
def mk_box(x, label, val):
    ax = fig.add_axes([x, 0.045, 0.075, 0.04], facecolor=PANEL)
    tb = TextBox(ax, label, initial=f"{val:.5f}", color=PANEL, hovercolor="#0a2f4a", label_pad=0.4)
    tb.label.set_color(DIM); tb.label.set_fontsize(8); tb.text_disp.set_color(C)
    return tb
s = state["fl"]
boxes = [mk_box(0.28, "START lat ", s.start[0]), mk_box(0.40, "lon ", s.start[1]),
         mk_box(0.52, "DEST lat ", s.dest[0]), mk_box(0.64, "lon ", s.dest[1])]
mult_ax = fig.add_axes([0.80, 0.045, 0.05, 0.04], facecolor=PANEL)
mult_tb = TextBox(mult_ax, "SIM x ", initial="auto", color=PANEL, hovercolor="#0a2f4a", label_pad=0.3)
mult_tb.label.set_color(DIM); mult_tb.label.set_fontsize(8); mult_tb.text_disp.set_color(C)

def read_coords():
    try:
        v = [float(b.text) for b in boxes]
    except ValueError:
        return None
    if abs(v[0]) > 90 or abs(v[2]) > 90 or abs(v[1]) > 180 or abs(v[3]) > 180:
        return None
    return (v[0], v[1]), (v[2], v[3])

def apply(_=None):
    c = read_coords(); f = state["fl"]
    if not c:
        f.note("Invalid coordinates (lat -90..90, lon -180..180)"); return
    (s0, d0) = c
    if hav(s0, d0) < 20:
        f.note("Start and destination must be 20 m apart"); return
    live = f.t > 0 and not f.done
    if live and tuple(s0) == f.start:
        f.reroute(d0)
    else:
        state["fl"] = Flight(s0, d0); state["run"] = False
    draw_static()

def start(_):
    f = state["fl"]
    if not f.done:
        state["run"] = True
        if f.t == 0:
            f.status = "IN FLIGHT"; f.note("Takeoff")

def pause(_):
    state["run"] = not state["run"]
    f = state["fl"]
    if not f.done:
        f.note("Resumed" if state["run"] else "Paused - hovering")

def reset(_):
    f = state["fl"]
    state["fl"] = Flight(f.start, f.dest); state["run"] = False; draw_static()

def default(_):
    for b, v in zip(boxes, (*DEF_S, *DEF_D)):
        b.set_val(f"{v:.5f}")
    state["fl"] = Flight(DEF_S, DEF_D); state["run"] = False; draw_static()

def set_mult(txt):
    try:
        state["mult"] = str(max(float(txt), 0.1))
    except ValueError:
        state["mult"] = "auto"
mult_tb.on_submit(set_mult)
for b in boxes:
    b.on_submit(lambda _t: apply())

btns = []
for x, lab, cb in ((0.28, "START", start), (0.36, "PAUSE", pause), (0.44, "RESET", reset), (0.52, "APPLY ROUTE", apply), (0.62, "DEFAULT", default)):
    ax = fig.add_axes([x, 0.105, 0.075 if lab != "APPLY ROUTE" else 0.095, 0.04])
    b = Button(ax, lab, color=PANEL, hovercolor="#0a3a5a"); b.label.set_color(C); b.label.set_fontsize(9)
    for sp in ax.spines.values():
        sp.set_edgecolor(C)
    b.on_clicked(cb); btns.append(b)

# click on map: sets destination (shift = start) -- uses key state tracked below
held = {"shift": False}
fig.canvas.mpl_connect("key_press_event", lambda e: held.update(shift=True) if e.key == "shift" else None)
fig.canvas.mpl_connect("key_release_event", lambda e: held.update(shift=False) if e.key == "shift" else None)

def on_click(e):
    if e.inaxes is not ax_map or e.button != 1:
        return
    v = state["view"]
    lat = v["lat"] + e.ydata / 111.32
    lon = (v["lon"] + e.xdata / (111.32 * v["c"]) + 540) % 360 - 180
    i = 0 if held["shift"] else 2
    boxes[i].set_val(f"{lat:.5f}"); boxes[i + 1].set_val(f"{lon:.5f}")
    apply()
fig.canvas.mpl_connect("button_press_event", on_click)

draw_static()
anim = FuncAnimation(fig, update, interval=50, cache_frame_data=False)
if args.snapshot:
    anim._draw_was_started = True
    state["run"] = True; state["fl"].status = "IN FLIGHT"
    for _ in range(args.frames):
        update(0)
    fig.savefig(args.snapshot, dpi=110, facecolor=BG)
    print("saved", args.snapshot)
else:
    plt.show()
return anim
def main():
ap = argparse.ArgumentParser(description="SkyRon-TL test flight simulator")
ap.add_argument("--start", nargs=2, type=float, default=list(DEF_S), metavar=("LAT", "LON"))
ap.add_argument("--dest", nargs=2, type=float, default=list(DEF_D), metavar=("LAT", "LON"))
ap.add_argument("--headless", action="store_true", help="run without a window and print a summary")
ap.add_argument("--snapshot", metavar="PNG", help="render a few frames offscreen and save a screenshot")
ap.add_argument("--frames", type=int, default=120, help="frames to simulate for --snapshot")
a = ap.parse_args()
for la, lo in (a.start, a.dest):
if abs(la) > 90 or abs(lo) > 180:
ap.error("latitude must be -90..90 and longitude -180..180")
a.start, a.dest = tuple(a.start), tuple(a.dest)
if hav(a.start, a.dest) < 20:
ap.error("start and destination must be at least 20 m apart")
headless(a) if a.headless else gui(a)

if name == "main":
main()
