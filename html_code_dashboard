   </div></div>
  <div class="card"><h2>FLIGHT LOG</h2><div id="log"></div></div>
 </section>
 
 <section>
  <div class="card"><h2>ROUTE PLANNER</h2>
   <div class="lbl">START · LAT, LON</div><div class="row"><input id="sLat" inputmode="decimal"><input id="sLon" inputmode="decimal"></div>
   <select id="sPre" class="full"></select>
