 <g filter="url(#g2)" stroke="#00e5ff" stroke-width="2" fill="#02060d"><line x1="-13" y1="-13" x2="13" y2="13"/><line x1="13" y1="-13" x2="-13" y2="13"/>
 <g transform="translate(-14,-14)"><circle r="8" fill="none" stroke-opacity=".6"/><line x1="-7" x2="7"><animateTransform attributeName="transform" type="rotate" from="0" to="360" dur=".25s" repeatCount="indefinite"/></line></g>
 <g transform="translate(14,-14)"><circle r="8" fill="none" stroke-opacity=".6"/><line x1="-7" x2="7"><animateTransform attributeName="transform" type="rotate" from="0" to="360" dur=".25s" repeatCount="indefinite"/></line></g>
 <g transform="translate(-14,14)"><circle r="8" fill="none" stroke-opacity=".6"/><line x1="-7" x2="7"><animateTransform attributeName="transform" type="rotate" from="360" to="0" dur=".25s" repeatCount="indefinite"/></line></g>
 <g transform="translate(14,14)"><circle r="8" fill="none" stroke-opacity=".6"/><line x1="-7" x2="7"><animateTransform attributeName="transform" type="rotate" from="360" to="0" dur=".25s" repeatCount="indefinite"/></line></g>
 <rect x="-6" y="-8" width="12" height="16" rx="4" fill="#00e5ff"/></g><path d="M0-34 L7-22 L-7-22Z" fill="#ffb020" filter="url(#g2)"/></g>
     <text id="dlab" font-family="Courier New" font-size="13" font-weight="700" fill="#00e5ff" stroke="#02060d" stroke-width="3" paint-order="stroke"></text><g transform="translate(560,40)" font-family="Courier New" font-weight="700" fill="#00e5ff" text-anchor="middle"><circle r="18" fill="none" stroke="#0d4a6e"/><path d="M0-14 L4 0 L-4 0Z"/><text y="22" font-size="11">N</text></g>
