<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SkyRon-TL Flight Simulator</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#02060d;--panel:#06121f;--c:#00e5ff;--b:#1e90ff;--dim:#5f89a8;--warn:#ffb020;--ok:#2dffa0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 50% 0,#07203a 0,var(--bg) 60%);color:#cfefff;font:13px/1.4 "Segoe UI",system-ui,sans-serif;min-height:100vh}
header{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-bottom:1px solid #0d3a55;flex-wrap:wrap;gap:8px}
h1{margin:0;font:700 20px "Courier New",monospace;letter-spacing:4px;color:var(--c);text-shadow:0 0 12px var(--c)}
h1 small{color:var(--dim);font-size:11px;letter-spacing:2px;display:block;text-shadow:none}
.pill{padding:4px 14px;border:1px solid var(--c);border-radius:20px;color:var(--c);font:700 12px "Courier New",monospace;letter-spacing:2px;box-shadow:0 0 10px #00e5ff55 inset,0 0 10px #00e5ff44}
.pill.run{color:var(--ok);border-color:var(--ok);box-shadow:0 0 10px #2dffa044}
.pill.pause{color:var(--warn);border-color:var(--warn)}
main{display:grid;grid-template-columns:260px minmax(0,1fr) 340px;gap:12px;padding:12px 18px}
@media(max-width:1000px){main{grid-template-columns:1fr}}
.card{background:linear-gradient(160deg,#071a2c,var(--panel));border:1px solid #0d4a6e;border-radius:10px;padding:12px;box-shadow:0 0 18px #00a8ff1f,inset 0 0 20px #00a8ff0d;margin-bottom:12px}
.card h2{margin:0 0 8px;font:600 11px "Courier New",monospace;letter-spacing:3px;color:var(--dim)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.t{border:1px solid #0d3a55;border-radius:6px;padding:6px 8px;background:#030b14}
.t span{display:block;font-size:10px;color:var(--dim);letter-spacing:1px}
.t b{font:700 20px "Courier New",monospace;color:var(--c);text-shadow:0 0 8px #00e5ff88}
.t b i{font-size:11px;font-style:normal;color:var(--dim);margin-left:2px}
.wide{grid-column:span 2}
.t.wide b{font-size:15px}
#batbar{height:8px;border-radius:4px;background:#0a2336;margin-top:4px;overflow:hidden}
#batfill{height:100%;width:100%;background:linear-gradient(90deg,var(--b),var(--c));box-shadow:0 0 10px var(--c);transition:width .2s}
.btns{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
button,select{background:#031524;color:var(--c);border:1px solid var(--c);border-radius:6px;padding:9px 4px;font:700 12px "Courier New",monospace;letter-spacing:2px;cursor:pointer;box-shadow:0 0 8px #00e5ff44}
button:hover{background:#06324d;box-shadow:0 0 16px #00e5ff99}
button:disabled{opacity:.35;cursor:default;box-shadow:none}
.eta{display:flex;justify-content:space-between;margin-top:10px;font:700 13px "Courier New",monospace;color:var(--c)}
.bar{height:6px;background:#0a2336;border-radius:3px;margin-top:8px;overflow:hidden}
#prog{height:100%;width:0;background:linear-gradient(90deg,var(--b),var(--c));box-shadow:0 0 10px var(--c)}
#map{width:100%;height:auto;display:block;border-radius:8px;background:#030b14;max-height:78vh}
.mapwrap{position:relative}
.hud{position:absolute;left:10px;bottom:10px;font:11px "Courier New",monospace;color:var(--dim);background:#02060dcc;padding:4px 8px;border:1px solid #0d3a55;border-radius:4px}
canvas{width:100%;height:170px;display:block;background:#030b14;border-radius:6px}
.lg{font:10px "Courier New",monospace;margin-top:4px;color:var(--dim)}
.lg b{color:var(--c)}.lg u{text-decoration:none;color:var(--warn)}
#log{font:11px "Courier New",monospace;color:#7fc8e8;height:92px;overflow:auto}
#log div{border-bottom:1px solid #0a2336;padding:1px 0}
.cmp{display:flex;flex-direction:column;align-items:center}
#hdgtxt{font:700 26px "Courier New",monospace;color:var(--c);text-shadow:0 0 10px var(--c);margin-top:4px}
.lbl{font:10px "Courier New",monospace;color:var(--dim);letter-spacing:2px;margin:8px 0 4px}
.row{display:flex;gap:8px;margin-bottom:6px;align-items:center}
.row button,.row select{flex:1}
input{flex:1;min-width:0;background:#030b14;color:var(--c);border:1px solid #0d4a6e;border-radius:6px;padding:8px;font:700 13px "Courier New",monospace;outline:none}
input:focus{border-color:var(--c);box-shadow:0 0 10px #00e5ff77}
.full{width:100%;margin-bottom:6px;padding:6px;font-size:11px}
#err{color:#ff6a6a;font:11px "Courier New",monospace;min-height:14px}
#grid text{stroke:none;fill:#2b6a8c;font:9px "Courier New"}
.flow{animation:fl 1s linear infinite}@keyframes fl{to{stroke-dashoffset:-14}}
#map{cursor:crosshair}
</style></head><body>
